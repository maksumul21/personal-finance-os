# Copy to .env and fill in. Never commit .env.

# Runtime connection. On Supabase use the transaction pooler (port 6543) and end the URL with
# ?sslmode=require&uselibpqcompat=true (plain sslmode=require makes the pg driver reject the pooler's certificate).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Connection used by Prisma migrations. On Supabase use the session pooler (port 5432) with ?sslmode=require.
# Optional locally. On Vercel, `vercel-build` applies pending migrations through it on each deploy.
DIRECT_URL=""

# Supabase project (Settings → API). Use the Project URL only, e.g. https://abcd.supabase.co (no /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Public base URL, used for auth email redirects
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Development only: act as this local user without Supabase (see docs/DECISIONS.md D-009).
# Ignored unless NODE_ENV=development.
DEV_AUTH_EMAIL=""
# Local prisma dev only: shadow database used by `prisma migrate dev`
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Daily job secret (Vercel sends it as "Authorization: Bearer <secret>"). Generate a long random value.
CRON_SECRET=""
