# Copy to .env and fill in. Never commit .env.

# Runtime connection. On Supabase use the pooler (transaction mode, port 6543) with ?pgbouncer=true
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Direct connection used by Prisma migrations (Supabase: port 5432). Optional locally.
DIRECT_URL=""

# Supabase project (Settings → API). Use the Project URL only, e.g. https://abcd.supabase.co (no /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Public base URL, used for auth email redirects
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Development only: act as this local user without Supabase (see docs/DECISIONS.md D-009).
# Ignored unless NODE_ENV=development.
DEV_AUTH_EMAIL=""
# Local prisma dev only: shadow database used by `prisma migrate dev`
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
