// Personal Finance OS — database schema.
// Money: Decimal(19,4). Exchange rates: Decimal(18,8). Calendar days: @db.Date.
// See docs/ARCHITECTURE.md for the ledger model and sign convention.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum AccountType {
  CASH
  BANK
  SAVINGS
  MFS
  CREDIT_CARD
  LOAN
  INVESTMENT
  OTHER_ASSET
}

enum MfsProvider {
  BKASH
  NAGAD
  ROCKET
  OTHER
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionSource {
  MANUAL
  RECURRING
  BILL
  DEBT
  GOAL
  IMPORT
}

enum NumberFormat {
  LAKH
  INTL
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum BudgetPeriodType {
  WEEKLY
  MONTHLY
  ANNUAL
  CUSTOM
}

enum BudgetMethod {
  STANDARD
  ZERO_BASED
  FIFTY_THIRTY_TWENTY
  SEVENTY_TWENTY_TEN
}

enum BudgetIncomeSource {
  PLANNED
  ACTUAL
}

/// What a budget line plans money for. Only EXPENSE_CATEGORY lines are compared with spending;
/// the others are planning entries (PRD §6.4) and never move money.
enum AllocationKind {
  EXPENSE_CATEGORY
  SAVINGS
  DEBT_REPAYMENT
  INVESTMENT
}

enum GoalType {
  GOAL
  EMERGENCY_FUND
  SINKING_FUND
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

enum ContributionDirection {
  DEPOSIT
  WITHDRAWAL
}

/// Unit of a repeating schedule: "every `interval` units". Quarterly = MONTHLY x 3.
enum RepeatUnit {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum OccurrenceState {
  PENDING
  PAID
  SKIPPED
}

enum DashboardPeriod {
  THIS_MONTH
  LAST_MONTH
  LAST_3_MONTHS
  LAST_6_MONTHS
  THIS_YEAR
}

// ───────────────────────────── Users ─────────────────────────────

/// id equals the Supabase auth.users id.
model User {
  id           String   @id @db.Uuid
  email        String   @unique
  name         String?
  avatarUrl    String?
  baseCurrency String   @default("BDT") @db.Char(3)
  timezone     String   @default("Asia/Dhaka")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  settings     UserSettings?
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  ledger       LedgerEntry[]
  auditLogs    AuditLog[]
  tags         Tag[]
  rates        ExchangeRate[]
  budgets      Budget[]
  goals        SavingsGoal[]
  recurring    RecurringRule[]
  bills        Bill[]
  loans        LoanTerms[]
  loanPayments LoanPayment[]
  holdings     Holding[]
  trades       HoldingTrade[]
  prices       HoldingPrice[]
  manualItems  ManualItem[]
  manualValues ManualValuation[]
}

model UserSettings {
  userId            String          @id @db.Uuid
  dateFormat        String          @default("dd MMM yyyy")
  numberFormat      NumberFormat    @default(LAKH)
  weekStartsOn      Int             @default(6) @db.SmallInt // 0 = Sunday … 6 = Saturday
  dashboardPeriod   DashboardPeriod @default(THIS_MONTH)
  theme             ThemePreference @default(SYSTEM)
  budgetWarnPct     Int             @default(70) @db.SmallInt
  budgetCriticalPct Int             @default(90) @db.SmallInt
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Accounts ─────────────────────────────

model Account {
  id                   String       @id @default(uuid()) @db.Uuid
  userId               String       @db.Uuid
  name                 String
  type                 AccountType
  provider             MfsProvider?
  currency             String       @db.Char(3)
  /// Signed, same convention as ledger entries (liabilities are negative).
  openingBalance       Decimal      @default(0) @db.Decimal(19, 4)
  openingDate          DateTime     @db.Date
  creditLimit          Decimal?     @db.Decimal(19, 4)
  color                String       @default("#4f46e5")
  icon                 String       @default("wallet")
  description          String?
  includeInSafeToSpend Boolean      @default(true)
  isArchived           Boolean      @default(false)
  sortOrder            Int          @default(0)
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries       LedgerEntry[]
  goals         SavingsGoal[]
  recurringFrom RecurringRule[] @relation("RecurringFrom")
  recurringTo   RecurringRule[] @relation("RecurringTo")
  bills         Bill[]
  loanTerms     LoanTerms?      @relation("LoanAccount")
  holdings      Holding[]
  loansPaidFrom LoanTerms[]     @relation("LoanPaymentAccount")

  @@unique([userId, name])
  @@index([userId, isArchived])
}

// ───────────────────────────── Categories ─────────────────────────────

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  name        String
  kind        CategoryKind
  parentId    String?      @db.Uuid
  icon        String       @default("tag")
  color       String       @default("#64748b")
  isDefault   Boolean      @default(false)
  isEssential Boolean      @default(false)
  isArchived  Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]         @relation("CategoryTree")
  transactions Transaction[]
  allocations  BudgetAllocation[]
  recurring    RecurringRule[]
  bills        Bill[]
  loans        LoanTerms[]

  @@index([userId, kind, isArchived])
  @@index([parentId])
}

// ───────────────────────────── Ledger ─────────────────────────────

model Transaction {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  type            TransactionType
  date            DateTime          @db.Date
  /// Positive amount in the source account's currency.
  amount          Decimal           @db.Decimal(19, 4)
  currency        String            @db.Char(3)
  exchangeRate    Decimal           @default(1) @db.Decimal(18, 8)
  baseAmount      Decimal           @db.Decimal(19, 4)
  categoryId      String?           @db.Uuid
  description     String?
  notes           String?
  isRefund        Boolean           @default(false)
  source          TransactionSource @default(MANUAL)
  recurringRuleId String?           @db.Uuid
  occurrenceDate  DateTime?         @db.Date
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  entries          LedgerEntry[]
  tags             TransactionTag[]
  /// Set when created by a goal contribution (TRANSFER) or a bill payment (EXPENSE).
  goalContribution GoalContribution?
  billOccurrence   BillOccurrence?
  /// Set when created by a loan payment: the principal TRANSFER or the interest EXPENSE.
  loanPrincipalOf  LoanPayment?      @relation("LoanPrincipalTx")
  loanInterestOf   LoanPayment?      @relation("LoanInterestTx")
  recurringRule    RecurringRule?    @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  @@unique([recurringRuleId, occurrenceDate])
  @@index([userId, date(sort: Desc)])
  @@index([userId, type, date])
  @@index([userId, categoryId, date])
}

model LedgerEntry {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @db.Uuid
  userId        String   @db.Uuid
  accountId     String   @db.Uuid
  /// Denormalised from Transaction.date for balance-as-of queries.
  date          DateTime @db.Date
  /// Signed, in the account's currency.
  amount        Decimal  @db.Decimal(19, 4)
  /// Signed, in the user's base currency.
  baseAmount    Decimal  @db.Decimal(19, 4)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, date])
  @@index([userId, date])
  @@index([transactionId])
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([userId, name])
}

model TransactionTag {
  transactionId String @db.Uuid
  tagId         String @db.Uuid

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
}

/// A user-recorded rate: 1 unit of `currency` = `rate` units of the user's base currency on `date`.
/// Never fetched or guessed (PRD §18.4).
model ExchangeRate {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  currency  String   @db.Char(3)
  rate      Decimal  @db.Decimal(18, 8)
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency, date])
  @@index([userId, currency, date(sort: Desc)])
}

// ───────────────────────────── Budgets ─────────────────────────────

model Budget {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @db.Uuid
  name          String
  periodType    BudgetPeriodType
  /// Inclusive calendar days.
  startDate     DateTime           @db.Date
  endDate       DateTime           @db.Date
  method        BudgetMethod       @default(STANDARD)
  plannedIncome Decimal?           @db.Decimal(19, 4)
  incomeSource  BudgetIncomeSource @default(PLANNED)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations BudgetAllocation[]

  @@index([userId, startDate, endDate])
}

model BudgetAllocation {
  id              String         @id @default(uuid()) @db.Uuid
  budgetId        String         @db.Uuid
  kind            AllocationKind
  /// Required for EXPENSE_CATEGORY; a group includes its subcategories' spending.
  categoryId      String?        @db.Uuid
  /// Name for planning lines (e.g. "Emergency fund").
  label           String?
  allocatedAmount Decimal        @db.Decimal(19, 4)
  rolloverEnabled Boolean        @default(false)
  sortOrder       Int            @default(0)

  budget   Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  /// Cascade: the service refuses to delete a category a budget uses, so this only fires when the
  /// whole user is deleted.
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
  @@index([categoryId])
}

// ───────────────────────────── Savings goals ─────────────────────────────

model SavingsGoal {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @db.Uuid
  name             String
  goalType         GoalType     @default(GOAL)
  /// Emergency fund: derived as essentialMonthly x targetMonths (kept in sync by the service).
  targetAmount     Decimal      @db.Decimal(19, 4)
  targetDate       DateTime?    @db.Date
  description      String?
  icon             String       @default("piggy-bank")
  color            String       @default("#0d9488")
  priority         GoalPriority @default(MEDIUM)
  /// Where the saved money lives. Contributions from another account move money into it.
  linkedAccountId  String?      @db.Uuid
  essentialMonthly Decimal?     @db.Decimal(19, 4)
  targetMonths     Int?         @db.SmallInt
  status           GoalStatus   @default(ACTIVE)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedAccount Account?           @relation(fields: [linkedAccountId], references: [id], onDelete: SetNull)
  contributions GoalContribution[]

  @@index([userId, status])
}

model GoalContribution {
  id            String                @id @default(uuid()) @db.Uuid
  goalId        String                @db.Uuid
  userId        String                @db.Uuid
  direction     ContributionDirection
  amount        Decimal               @db.Decimal(19, 4)
  date          DateTime              @db.Date
  notes         String?
  /// The real transfer behind this contribution; null for an earmark of money already in place.
  transactionId String?               @unique @db.Uuid
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)

  goal        SavingsGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([goalId, date])
  @@index([userId])
}

// ───────────────────────────── Recurring transactions ─────────────────────────────

model RecurringRule {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @db.Uuid
  type           TransactionType
  amount         Decimal         @db.Decimal(19, 4)
  categoryId     String?         @db.Uuid
  accountId      String          @db.Uuid
  toAccountId    String?         @db.Uuid
  /// Cross-currency transfers only.
  toAmount       Decimal?        @db.Decimal(19, 4)
  description    String?
  unit           RepeatUnit
  interval       Int             @default(1) @db.SmallInt
  startDate      DateTime        @db.Date
  endDate        DateTime?       @db.Date
  /// Next occurrence not yet posted. Null once the schedule has ended.
  nextOccurrence DateTime?       @db.Date
  status         ScheduleStatus  @default(ACTIVE)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  /// Cascades exist so deleting a user works; the services refuse to delete an account or
  /// category a schedule still uses.
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  account      Account       @relation("RecurringFrom", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount    Account?      @relation("RecurringTo", fields: [toAccountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([status, nextOccurrence])
  @@index([userId])
}

// ───────────────────────────── Bills & subscriptions ─────────────────────────────

model Bill {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  name             String
  amount           Decimal        @db.Decimal(19, 4)
  categoryId       String         @db.Uuid
  paymentAccountId String         @db.Uuid
  /// Null unit = one-off bill.
  unit             RepeatUnit?
  interval         Int            @default(1) @db.SmallInt
  firstDueDate     DateTime       @db.Date
  endDate          DateTime?      @db.Date
  isSubscription   Boolean        @default(false)
  notes            String?
  status           ScheduleStatus @default(ACTIVE)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  paymentAccount Account          @relation(fields: [paymentAccountId], references: [id], onDelete: Cascade)
  occurrences    BillOccurrence[]

  @@index([userId, status])
}

model BillOccurrence {
  id            String          @id @default(uuid()) @db.Uuid
  billId        String          @db.Uuid
  userId        String          @db.Uuid
  dueDate       DateTime        @db.Date
  amount        Decimal         @db.Decimal(19, 4)
  state         OccurrenceState @default(PENDING)
  /// The expense recorded for this payment. Unique: one payment can't settle two occurrences.
  transactionId String?         @unique @db.Uuid
  paidAt        DateTime?       @db.Date

  bill        Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([billId, dueDate])
  @@index([userId, dueDate])
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Terms of a loan, one per LOAN account (ROADMAP Phase 4). The amount owed is always the
/// account's ledger balance; these fields only describe the contract and drive EMI splits.
model LoanTerms {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  accountId          String   @unique @db.Uuid
  /// Amount originally borrowed (may be more than owed today).
  principal          Decimal  @db.Decimal(19, 4)
  /// Annual interest rate in percent (9.5 = 9.5% a year), compounded monthly.
  annualRate         Decimal  @db.Decimal(7, 4)
  termMonths         Int      @db.SmallInt
  /// Date of the first instalment.
  firstPaymentDate   DateTime @db.Date
  /// Monthly instalment. Defaults to the computed EMI; editable to match the lender.
  emiAmount          Decimal  @db.Decimal(19, 4)
  /// Account EMIs are usually paid from.
  paymentAccountId   String   @db.Uuid
  /// Expense category for the interest part (DECISIONS.md D-002).
  interestCategoryId String   @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account          Account       @relation("LoanAccount", fields: [accountId], references: [id], onDelete: Cascade)
  paymentAccount   Account       @relation("LoanPaymentAccount", fields: [paymentAccountId], references: [id], onDelete: Cascade)
  interestCategory Category      @relation(fields: [interestCategoryId], references: [id], onDelete: Cascade)
  payments         LoanPayment[]

  @@index([userId])
}

/// One instalment: a principal TRANSFER (payment account → loan account) and, when interest is
/// due, an interest EXPENSE, created and removed together.
model LoanPayment {
  id                     String   @id @default(uuid()) @db.Uuid
  loanId                 String   @db.Uuid
  userId                 String   @db.Uuid
  date                   DateTime @db.Date
  principal              Decimal  @db.Decimal(19, 4)
  interest               Decimal  @db.Decimal(19, 4)
  principalTransactionId String?  @unique @db.Uuid
  interestTransactionId  String?  @unique @db.Uuid
  createdAt              DateTime @default(now()) @db.Timestamptz(3)

  loan                 LoanTerms    @relation(fields: [loanId], references: [id], onDelete: Cascade)
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  principalTransaction Transaction? @relation("LoanPrincipalTx", fields: [principalTransactionId], references: [id], onDelete: SetNull)
  interestTransaction  Transaction? @relation("LoanInterestTx", fields: [interestTransactionId], references: [id], onDelete: SetNull)

  @@index([loanId, date])
  @@index([userId])
}

enum AssetClass {
  STOCK
  MUTUAL_FUND
  BOND
  SAVINGS_CERTIFICATE
  FIXED_DEPOSIT
  GOLD
  CRYPTO
  OTHER
}

enum TradeSide {
  BUY
  SELL
}

/// Something held in an INVESTMENT account (DECISIONS.md D-029). Units and cost come from its
/// trades (average cost); value from the latest recorded price.
model Holding {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  accountId  String     @db.Uuid
  name       String
  symbol     String?
  assetClass AssetClass @default(STOCK)
  notes      String?
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  trades  HoldingTrade[]
  prices  HoldingPrice[]

  @@unique([accountId, name])
  @@index([userId])
}

/// A buy or sell. Moves money between the account's cash and the holding; never a ledger entry.
model HoldingTrade {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  holdingId String    @db.Uuid
  side      TradeSide
  date      DateTime  @db.Date
  units     Decimal   @db.Decimal(24, 8)
  /// BUY: total paid incl. fees. SELL: proceeds after fees. In the account's currency.
  amount    Decimal   @db.Decimal(19, 4)
  notes     String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  holding Holding @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@index([holdingId, date])
  @@index([userId])
}

/// A recorded price per unit on a date. Valuation uses the latest on or before the date.
model HoldingPrice {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  holdingId String   @db.Uuid
  date      DateTime @db.Date
  price     Decimal  @db.Decimal(24, 8)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  holding Holding @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@unique([holdingId, date])
  @@index([userId])
}

enum ManualItemKind {
  ASSET
  LIABILITY
}

enum ManualItemCategory {
  PROPERTY
  VEHICLE
  VALUABLES
  RECEIVABLE
  BUSINESS
  RETIREMENT
  PERSONAL_DEBT
  TAX
  OTHER
}

/// Something you own or owe that isn't an account (a flat, a car, gold, money lent or borrowed
/// informally). Its value comes from dated valuations (DECISIONS.md D-030).
model ManualItem {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @db.Uuid
  name       String
  kind       ManualItemKind
  category   ManualItemCategory @default(OTHER)
  currency   String             @db.Char(3)
  notes      String?
  isArchived Boolean            @default(false)
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @db.Timestamptz(3)

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  valuations ManualValuation[]

  @@unique([userId, name])
  @@index([userId, isArchived])
}

/// The item's value (asset) or amount owed (liability) from this date on, until the next one.
model ManualValuation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  itemId    String   @db.Uuid
  date      DateTime @db.Date
  value     Decimal  @db.Decimal(19, 4)
  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ManualItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, date])
  @@index([userId])
}
